#!/usr/bin/env bash
# Real user path: the CLI a founder runs (`python -m canswim -h`).
# Never gatherdata / forecast / dashboard / mcp (those can hit ~/.canswim or hang).
set -euo pipefail
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"

PY=(python3)
if command -v conda >/dev/null 2>&1; then
  if [[ -f "${HOME}/anaconda3/etc/profile.d/conda.sh" ]]; then
    # shellcheck source=/dev/null
    source "${HOME}/anaconda3/etc/profile.d/conda.sh"
  fi
  if conda env list 2>/dev/null | awk '{print $1}' | grep -qx canswim; then
    PY=(conda run -n canswim --no-capture-output python)
  fi
fi

if ! "${PY[@]}" -c "import canswim" 2>/dev/null; then
  "${PY[@]}" -m pip install -e .
fi

out="$("${PY[@]}" -m canswim -h)"
printf '%s\n' "$out"
printf '%s\n' "$out" | grep -q -- '--tickers'
printf '%s\n' "$out" | grep -q gatherdata
printf '%s\n' "$out" | grep -q forecast
printf '%s\n' "$out" | grep -q mcp
echo "verify:user-path OK (python -m canswim -h)"
